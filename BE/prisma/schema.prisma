generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tb_apc {
  id_apc          Int               @id @default(autoincrement())
  id_institusi    Int
  nidn            String            @db.VarChar(20)
  no_ktp          String            @default("") @db.VarChar(16)
  no_npwp         String            @default("") @db.VarChar(30)
  no_rek          String            @default("") @db.VarChar(30)
  tipe_publikasi  String            @db.VarChar(50)
  judul_publikasi String            @db.VarChar(200)
  nama_jurnal     String            @db.VarChar(100)
  link_jurnal     String?           @db.VarChar(300)
  link_artikel    String?           @db.VarChar(300)
  quartil         String?           @db.VarChar(5)
  auth_ke         Int?
  tgl_invoice     DateTime?         @db.Date
  tgl_payment     DateTime?         @db.Date
  mata_uang       String?           @db.VarChar(100)
  total_payment   BigInt?
  status_usulan   String?           @db.VarChar(100)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime          @default(now()) @db.Timestamp(0)
  tb_apc_lampiran tb_apc_lampiran[]
  tb_apc_mhs      tb_apc_mhs[]
}

model tb_apc_lampiran {
  id_lampiran    Int                             @id @default(autoincrement())
  id_apc         Int
  jenis_lampiran tb_apc_lampiran_jenis_lampiran?
  lampiran       String                          @db.VarChar(300)
  created_at     DateTime                        @default(now()) @db.Timestamp(0)
  tb_apc         tb_apc                          @relation(fields: [id_apc], references: [id_apc], onDelete: Cascade, map: "fk_apc_lamp_apc")

  @@index([id_apc], map: "fk_apc_lamp_apc")
}

model tb_apc_mhs {
  id_apc_mhs Int      @id @default(autoincrement())
  nim        String   @db.VarChar(14)
  id_apc     Int
  id_prodi   Int?
  nama_mhs   String?  @db.VarChar(100)
  degree     String?  @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(0)
  tb_apc     tb_apc   @relation(fields: [id_apc], references: [id_apc], onDelete: Cascade, map: "fk_apc_mhs_apc")

  @@unique([nim, id_apc], map: "uq_apc_mhs")
  @@index([id_apc], map: "fk_apc_mhs_apc")
}

model tb_api_key {
  id_api_key Int      @id @default(autoincrement())
  id_user    Int
  nama       String   @db.VarChar(100)
  api_key    String   @unique(map: "uq_api_key") @db.VarChar(128)
  is_active  Int      @default(1) @db.TinyInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  tb_user    tb_user  @relation(fields: [id_user], references: [id_user], onDelete: Cascade, map: "fk_apikey_user")

  @@index([id_user], map: "idx_apikey_user")
}

model tb_bidang_penelitian {
  id_bidang   Int         @id @default(autoincrement())
  nama_bidang String      @unique(map: "uq_nama_bidang") @db.VarChar(200)
  status      Int         @default(1) @db.TinyInt
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  tb_usulan   tb_usulan[]
}

model tb_desk_penelitian {
  id_desk       Int                          @id @default(autoincrement())
  id_usulan     Int
  id_reviewer   Int
  nidn_reviewer String                       @db.VarChar(20)
  skor_1        Int                          @default(0)
  nilai_1       Int                          @default(0)
  skor_2        Int                          @default(0)
  nilai_2       Int                          @default(0)
  skor_3        Int                          @default(0)
  nilai_3       Int                          @default(0)
  skor_4        Int                          @default(0)
  nilai_4       Int                          @default(0)
  skor_5        Int                          @default(0)
  nilai_5       Int                          @default(0)
  skor_6        Int                          @default(0)
  nilai_6       Int                          @default(0)
  total         Int                          @default(0)
  rekom_dana    BigInt                       @default(0)
  rekom_dana2   BigInt                       @default(0)
  rekom_dana3   BigInt                       @default(0)
  rekom_dana4   BigInt                       @default(0)
  komentar      String                       @db.Text
  ketetapan     tb_desk_penelitian_ketetapan @default(revisi)
  cat_manaj     String                       @db.Text
  tanggal       DateTime                     @db.Date
  created_at    DateTime                     @default(now()) @db.Timestamp(0)
  updated_at    DateTime                     @default(now()) @db.Timestamp(0)
  tb_usulan     tb_usulan                    @relation(fields: [id_usulan], references: [id_usulan], map: "fk_desk_pen_usulan")

  @@unique([id_usulan, id_reviewer], map: "uq_desk_pen")
}

model tb_desk_pengabdian {
  id_desk       Int                          @id @default(autoincrement())
  id_usulan     Int
  id_reviewer   Int
  nidn_reviewer String                       @db.VarChar(20)
  skor_1        Int                          @default(0)
  nilai_1       Int                          @default(0)
  skor_2        Int                          @default(0)
  nilai_2       Int                          @default(0)
  skor_3        Int                          @default(0)
  nilai_3       Int                          @default(0)
  skor_4        Int                          @default(0)
  nilai_4       Int                          @default(0)
  skor_5        Int                          @default(0)
  nilai_5       Int                          @default(0)
  skor_6        Int                          @default(0)
  nilai_6       Int                          @default(0)
  skor_7        Int                          @default(0)
  nilai_7       Int                          @default(0)
  skor_8        Int                          @default(0)
  nilai_8       Int                          @default(0)
  skor_9        Int                          @default(0)
  nilai_9       Int                          @default(0)
  skor_10       Int                          @default(0)
  nilai_10      Int                          @default(0)
  skor_11       Int                          @default(0)
  nilai_11      Int                          @default(0)
  skor_12       Int                          @default(0)
  nilai_12      Int                          @default(0)
  skor_13       Int                          @default(0)
  nilai_13      Int                          @default(0)
  skor_14       Int                          @default(0)
  nilai_14      Int                          @default(0)
  skor_15       Int                          @default(0)
  nilai_15      Int                          @default(0)
  total         Int                          @default(0)
  rekom_dana    BigInt                       @default(0)
  rekom_dana2   BigInt                       @default(0)
  rekom_dana3   BigInt                       @default(0)
  rekom_dana4   BigInt                       @default(0)
  komentar      String                       @db.Text
  ketetapan     tb_desk_pengabdian_ketetapan @default(revisi)
  cat_manaj     String                       @db.Text
  tanggal       DateTime                     @db.Date
  created_at    DateTime                     @default(now()) @db.Timestamp(0)
  updated_at    DateTime                     @default(now()) @db.Timestamp(0)
  tb_usulan     tb_usulan                    @relation(fields: [id_usulan], references: [id_usulan], map: "fk_desk_peng_usulan")

  @@unique([id_usulan, id_reviewer], map: "uq_desk_peng")
}

model tb_dosen {
  nidn                  String                     @id @db.VarChar(20)
  id_user               Int?                       @unique(map: "uq_dosen_user")
  id_institusi          Int
  id_fakultas           Int?
  id_prodi              Int?
  id_pegawai            Int?
  nip                   String                     @default("") @db.VarChar(25)
  nuptk                 String?                    @db.VarChar(16)
  namalengkap           String                     @db.VarChar(100)
  sex                   tb_dosen_sex
  fungsional            String                     @default("") @db.VarChar(50)
  pangkat               String                     @default("") @db.VarChar(50)
  golongan              String                     @default("") @db.VarChar(5)
  tmplhr                String                     @default("") @db.VarChar(100)
  tgllhr                DateTime?                  @db.Date
  status                tb_dosen_status            @default(aktif)
  tahun_aktif_mulai     Int?                       @db.Year
  tahun_aktif_selesai   Int?                       @db.Year
  keilmuan              String                     @db.Text
  bidang_ilmu           String?                    @db.VarChar(100)
  alamatrumah           String                     @default("") @db.VarChar(300)
  email                 String                     @default("") @db.VarChar(100)
  telp                  String                     @default("") @db.VarChar(16)
  fax                   String                     @default("") @db.VarChar(20)
  alamatkantor          String                     @default("") @db.VarChar(500)
  faxkantor             String                     @default("") @db.VarChar(20)
  emailkantor           String                     @default("") @db.VarChar(100)
  scopus_id             String                     @default("") @db.VarChar(50)
  h_index               Int                        @default(0)
  sinta_id              String?                    @db.VarChar(10)
  sinta_score           Int?
  validasi              String?                    @db.VarChar(20)
  tgl_validasi          DateTime?                  @db.Date
  status_penelitian     tb_dosen_status_penelitian @default(aktif)
  status_pengabdian     tb_dosen_status_pengabdian @default(aktif)
  tgl_update_penelitian DateTime?                  @db.DateTime(0)
  updated_by_penelitian Int?
  tgl_update_pengabdian DateTime?                  @db.DateTime(0)
  updated_by_pengabdian Int?
  created_at            DateTime                   @default(now()) @db.Timestamp(0)
  updated_at            DateTime                   @default(now()) @db.Timestamp(0)
  tb_fakultas           tb_fakultas?               @relation(fields: [id_fakultas], references: [id_fakultas], map: "fk_dosen_fakultas")
  tb_institusi          tb_institusi               @relation(fields: [id_institusi], references: [id_institusi], map: "fk_dosen_institusi")
  tb_prodi              tb_prodi?                  @relation(fields: [id_prodi], references: [id_prodi], map: "fk_dosen_prodi")
  tb_user               tb_user?                   @relation(fields: [id_user], references: [id_user], map: "fk_dosen_user")
  tb_dosen_pendidikan   tb_dosen_pendidikan[]
  tb_eks_usulan         tb_eks_usulan[]
  tb_reviewer_profil    tb_reviewer_profil?
  tb_usulan             tb_usulan[]

  @@index([id_fakultas], map: "idx_dosen_fakultas")
  @@index([id_institusi], map: "idx_dosen_institusi")
  @@index([id_prodi], map: "idx_dosen_prodi")
}

model tb_dosen_pendidikan {
  id_pendidikan Int                         @id @default(autoincrement())
  nidn          String                      @db.VarChar(20)
  jenjang       tb_dosen_pendidikan_jenjang
  bidang_studi  String                      @db.VarChar(200)
  institusi     String                      @db.VarChar(200)
  tahun_masuk   Int?                        @db.Year
  tahun_lulus   Int?                        @db.Year
  is_tertinggi  Int                         @default(0) @db.TinyInt
  created_at    DateTime                    @default(now()) @db.Timestamp(0)
  updated_at    DateTime                    @default(now()) @db.Timestamp(0)
  tb_dosen      tb_dosen                    @relation(fields: [nidn], references: [nidn], onDelete: Cascade, map: "fk_pendidikan_dosen")

  @@index([nidn], map: "idx_pendidikan_nidn")
}

model tb_eduk {
  id_eduk      Int      @id @default(autoincrement())
  id_institusi Int
  id_fakultas  Int
  tahun        Int      @db.Year
  s1           Int      @default(0)
  s2           Int      @default(0)
  s3           Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @db.Timestamp(0)

  @@unique([id_fakultas, tahun], map: "uq_eduk_fak_tahun")
}

model tb_eks_anggota {
  id_anggota      Int           @id @default(autoincrement())
  id_usulan       Int
  nidn            String        @db.VarChar(20)
  persetujuan     Int           @default(0) @db.TinyInt
  tgl_persetujuan DateTime?     @db.DateTime(0)
  created_at      DateTime      @default(now()) @db.Timestamp(0)
  updated_at      DateTime      @default(now()) @db.Timestamp(0)
  tb_eks_usulan   tb_eks_usulan @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_eks_anggota_usulan")

  @@unique([id_usulan, nidn], map: "uq_anggota_usulan")
}

model tb_eks_assignment {
  id_assignment          Int                      @id @default(autoincrement())
  id_usulan              Int
  id_reviewer            Int
  nidn_reviewer          String                   @db.VarChar(20)
  id_template            Int
  tahap                  tb_eks_assignment_tahap
  status                 tb_eks_assignment_status @default(ditugaskan)
  ditugaskan_oleh        Int
  nama_penugasan         String                   @default("") @db.VarChar(100)
  tgl_ditugaskan         DateTime                 @db.Date
  tgl_batas              DateTime?                @db.Date
  created_at             DateTime                 @default(now()) @db.Timestamp(0)
  updated_at             DateTime                 @default(now()) @db.Timestamp(0)
  tb_eks_template_review tb_eks_template_review   @relation(fields: [id_template], references: [id_template], map: "fk_eks_assign_template")
  tb_eks_usulan          tb_eks_usulan            @relation(fields: [id_usulan], references: [id_usulan], map: "fk_eks_assign_usulan")

  @@unique([id_usulan, id_reviewer, tahap], map: "uq_assignment")
  @@index([id_template], map: "fk_eks_assign_template")
}

model tb_eks_desk {
  id_desk                Int                    @id @default(autoincrement())
  id_usulan              Int
  id_reviewer            Int
  nidn_reviewer          String                 @db.VarChar(20)
  id_template            Int
  total_skor             Int                    @default(0)
  rekom_dana             BigInt?
  komentar               String?                @db.Text
  ketetapan              tb_eks_desk_ketetapan  @default(revisi)
  cat_manaj              String?                @db.VarChar(255)
  tanggal                DateTime?              @db.Date
  created_at             DateTime               @default(now()) @db.Timestamp(0)
  updated_at             DateTime               @default(now()) @db.Timestamp(0)
  tb_eks_template_review tb_eks_template_review @relation(fields: [id_template], references: [id_template], map: "fk_eks_desk_template")
  tb_eks_usulan          tb_eks_usulan          @relation(fields: [id_usulan], references: [id_usulan], map: "fk_eks_desk_usulan")

  @@unique([id_usulan, id_reviewer], map: "uq_desk")
  @@index([id_template], map: "fk_eks_desk_template")
}

model tb_eks_field_review {
  id_field               Int                    @id @default(autoincrement())
  id_template            Int
  indikator              String                 @db.Text
  komponen_penilaian     String?                @db.Text
  bobot_penilaian        Int                    @default(0)
  skor_maks              Int                    @default(100)
  urutan                 Int                    @default(0)
  created_at             DateTime               @default(now()) @db.Timestamp(0)
  updated_at             DateTime               @default(now()) @db.Timestamp(0)
  tb_eks_template_review tb_eks_template_review @relation(fields: [id_template], references: [id_template], onDelete: Cascade, map: "fk_eks_fieldreview_template")
  tb_eks_value_review    tb_eks_value_review[]

  @@index([id_template], map: "fk_eks_fieldreview_template")
}

model tb_eks_field_usulan {
  id_field            Int                   @id @default(autoincrement())
  id_skema            Int
  field_name          String                @db.VarChar(255)
  valued_by           String                @default("manual") @db.VarChar(50)
  label_name          String?               @db.VarChar(100)
  input_type          String?               @db.VarChar(100)
  reference_object    String?               @db.VarChar(100)
  id_input            String?               @db.VarChar(100)
  default_value       String?               @db.VarChar(100)
  urutan              Int                   @default(0)
  is_required         Int                   @default(0) @db.TinyInt
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  tb_eks_skema        tb_eks_skema          @relation(fields: [id_skema], references: [id_skema], onDelete: Cascade, map: "fk_eks_field_skema")
  tb_eks_value_usulan tb_eks_value_usulan[]

  @@index([id_skema], map: "fk_eks_field_skema")
}

model tb_eks_lampiran {
  id_lampiran   Int                        @id @default(autoincrement())
  id_usulan     Int
  jenis_file    tb_eks_lampiran_jenis_file
  nama_file     String                     @db.VarChar(255)
  path_file     String                     @db.VarChar(500)
  ukuran_file   Int                        @default(0)
  mime_type     String?                    @db.VarChar(100)
  keterangan    String?                    @db.Text
  diunggah_oleh Int
  created_at    DateTime                   @default(now()) @db.Timestamp(0)
  updated_at    DateTime                   @default(now()) @db.Timestamp(0)
  tb_eks_usulan tb_eks_usulan              @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_eks_lampiran_usulan")

  @@index([id_usulan], map: "fk_eks_lampiran_usulan")
}

model tb_eks_mahasiswa {
  id_mahasiswa  Int           @id @default(autoincrement())
  id_usulan     Int
  nim           String        @db.VarChar(20)
  nama_mhs      String        @db.VarChar(255)
  id_fakultas   Int?
  id_prodi      Int?
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  tb_eks_usulan tb_eks_usulan @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_eks_mhs_usulan")

  @@index([id_usulan], map: "fk_eks_mhs_usulan")
}

model tb_eks_mitra {
  id_mitra      Int           @id @default(autoincrement())
  id_usulan     Int
  nama_mitra    String?       @db.VarChar(255)
  instansi      String?       @db.VarChar(255)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  tb_eks_usulan tb_eks_usulan @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_eks_mitra_usulan")

  @@index([id_usulan], map: "fk_eks_mitra_usulan")
}

model tb_eks_monev {
  id_monev               Int                    @id @default(autoincrement())
  id_usulan              Int
  id_reviewer            Int
  nidn_reviewer          String                 @db.VarChar(20)
  id_template            Int
  total_skor             Int                    @default(0)
  rekom_dana             BigInt?
  komentar               String?                @db.Text
  ketetapan              tb_eks_monev_ketetapan @default(lanjut)
  cat_manaj              String?                @db.VarChar(255)
  tanggal                DateTime?              @db.Date
  created_at             DateTime               @default(now()) @db.Timestamp(0)
  updated_at             DateTime               @default(now()) @db.Timestamp(0)
  tb_eks_template_review tb_eks_template_review @relation(fields: [id_template], references: [id_template], map: "fk_eks_monev_template")
  tb_eks_usulan          tb_eks_usulan          @relation(fields: [id_usulan], references: [id_usulan], map: "fk_eks_monev_usulan")

  @@unique([id_usulan, id_reviewer], map: "uq_monev")
  @@index([id_template], map: "fk_eks_monev_template")
}

model tb_eks_paparan {
  id_paparan             Int                      @id @default(autoincrement())
  id_usulan              Int
  id_reviewer            Int
  nidn_reviewer          String                   @db.VarChar(20)
  id_template            Int
  total_skor             Int                      @default(0)
  rekom_dana             BigInt?
  komentar               String?                  @db.Text
  ketetapan              tb_eks_paparan_ketetapan @default(revisi)
  cat_manaj              String?                  @db.VarChar(255)
  tanggal                DateTime?                @db.Date
  created_at             DateTime                 @default(now()) @db.Timestamp(0)
  updated_at             DateTime                 @default(now()) @db.Timestamp(0)
  tb_eks_template_review tb_eks_template_review   @relation(fields: [id_template], references: [id_template], map: "fk_eks_paparan_template")
  tb_eks_usulan          tb_eks_usulan            @relation(fields: [id_usulan], references: [id_usulan], map: "fk_eks_paparan_usulan")

  @@unique([id_usulan, id_reviewer], map: "uq_paparan")
  @@index([id_template], map: "fk_eks_paparan_template")
}

model tb_eks_program {
  id_program   Int                     @id @default(autoincrement())
  id_institusi Int
  random_id    String?                 @unique(map: "uq_random_id") @db.VarChar(24)
  nama_program String                  @db.VarChar(150)
  deskripsi    String?                 @db.Text
  kategori     tb_eks_program_kategori @default(lainnya)
  nama_pemberi String                  @db.VarChar(200)
  status       tb_eks_program_status   @default(aktif)
  created_at   DateTime                @default(now()) @db.Timestamp(0)
  updated_at   DateTime                @default(now()) @db.Timestamp(0)
  tb_eks_skema tb_eks_skema[]
}

model tb_eks_skema {
  id_skema               Int                      @id @default(autoincrement())
  id_program             Int
  nama_skema             String                   @db.VarChar(150)
  kegiatan               tb_eks_skema_kegiatan
  status                 tb_eks_skema_status      @default(aktif)
  created_at             DateTime                 @default(now()) @db.Timestamp(0)
  updated_at             DateTime                 @default(now()) @db.Timestamp(0)
  tb_eks_field_usulan    tb_eks_field_usulan[]
  tb_eks_program         tb_eks_program           @relation(fields: [id_program], references: [id_program], map: "fk_eks_skema_program")
  tb_eks_skema_reviewer  tb_eks_skema_reviewer[]
  tb_eks_syarat          tb_eks_syarat[]
  tb_eks_template_review tb_eks_template_review[]
  tb_eks_timeline        tb_eks_timeline[]
  tb_eks_usulan          tb_eks_usulan[]

  @@index([id_program], map: "fk_eks_skema_program")
}

model tb_eks_skema_reviewer {
  id                 Int                @id @default(autoincrement())
  id_skema           Int
  id_reviewer        Int
  ditambahkan_oleh   Int
  created_at         DateTime           @default(now()) @db.Timestamp(0)
  tb_reviewer_profil tb_reviewer_profil @relation(fields: [id_reviewer], references: [id_reviewer], onDelete: Cascade, map: "fk_eks_skema_rev_rev")
  tb_eks_skema       tb_eks_skema       @relation(fields: [id_skema], references: [id_skema], onDelete: Cascade, map: "fk_eks_skema_rev_skema")

  @@unique([id_skema, id_reviewer], map: "uq_eks_skema_reviewer")
  @@index([id_reviewer], map: "fk_eks_skema_rev_rev")
}

model tb_eks_syarat {
  id_syarat    Int          @id @default(autoincrement())
  id_skema     Int
  indikator    String       @db.VarChar(200)
  operator     String       @db.VarChar(10)
  value_type   String       @db.VarChar(10)
  value        String       @db.VarChar(255)
  keterangan   String?      @db.VarChar(300)
  created_at   DateTime     @default(now()) @db.Timestamp(0)
