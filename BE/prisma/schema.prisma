  ketua_mitra    String?         @db.VarChar(200)
  alamat         String?         @db.VarChar(300)
  kelurahan      String?         @db.VarChar(100)
  kecamatan      String?         @db.VarChar(100)
  kabupaten      String?         @db.VarChar(100)
  provinsi       String?         @db.VarChar(100)
  gmaps          String?         @db.VarChar(500)
  telp           String?         @db.VarChar(20)
  email          String?         @db.VarChar(200)
  desa           String?         @db.VarChar(300)
  kades          String?         @db.VarChar(300)
  created_at     DateTime        @default(now()) @db.Timestamp(0)
  tb_jenis_mitra tb_jenis_mitra? @relation(fields: [id_jenis_mitra], references: [id_jenis_mitra], map: "fk_mitra_jenis")
  tb_usulan      tb_usulan       @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_mitra_usulan")

  @@index([id_jenis_mitra], map: "fk_mitra_jenis")
  @@index([id_usulan], map: "fk_mitra_usulan")
}

model tb_usulan_pembimbing {
  id_pembimbing Int       @id @default(autoincrement())
  id_usulan     Int
  nidn          String    @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  tb_usulan     tb_usulan @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_pembimbing_usulan")

  @@unique([id_usulan, nidn], map: "uq_pembimbing_usulan")
}

model tb_usulan_pengesahan {
  id_pengesahan  Int       @id @default(autoincrement())
  id_usulan      Int       @unique(map: "uq_pengesahan_usulan")
  pimpinan       String    @db.VarChar(300)
  nip_pimpinan   String    @db.VarChar(18)
  jabatan        String    @db.VarChar(200)
  ketua_lppm     String    @db.VarChar(200)
  nip_ketualppm  String    @db.VarChar(18)
  tgl_pengesahan DateTime? @db.Date
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  updated_at     DateTime  @default(now()) @db.Timestamp(0)
  tb_usulan      tb_usulan @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_pengesahan_usulan")
}

model tb_usulan_validasi {
  id_validasi     Int                       @id @default(autoincrement())
  id_usulan       Int
  tahap           tb_usulan_validasi_tahap
  status          tb_usulan_validasi_status @default(menunggu)
  catatan         String?                   @db.Text
  divalidasi_oleh Int?
  nama_validator  String                    @default("") @db.VarChar(100)
  tgl_validasi    DateTime?                 @db.DateTime(0)
  is_current      Int                       @default(1) @db.TinyInt
  created_at      DateTime                  @default(now()) @db.Timestamp(0)
  updated_at      DateTime                  @default(now()) @db.Timestamp(0)
  tb_usulan       tb_usulan                 @relation(fields: [id_usulan], references: [id_usulan], onDelete: Cascade, map: "fk_validasi_usulan")

  @@index([id_usulan], map: "fk_validasi_usulan")
}

